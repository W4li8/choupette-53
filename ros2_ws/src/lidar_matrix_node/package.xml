<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_matrix_node</name>
  <version>0.1.0</version>
  <description>
    ROS2 node for the DFRobot 8x8 Matrix ToF (VL53L7CX) lidar, reusing
    the ESP32 firmware's vendored I2C protocol driver unmodified.
  </description>
  <maintainer email="1filip.4slezak@gmail.com">Filip Slezak</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
